{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim evidence matrix",
  "type": "object",
  "required": ["head_sha", "claims"],
  "additionalProperties": false,
  "properties": {
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "evidence", "scope", "status", "publication_text"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "scope": {"type": "string"},
          "status": {"enum": ["VERIFIED", "PARTIAL", "UNSUPPORTED", "NOT_APPLICABLE"]},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "publication_text": {"type": "string"}
        }
      }
    }
  }
}
